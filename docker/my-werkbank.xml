<?xml version="1.0"?>
<Container version="2">
  <Name>werkbank</Name>
  <Repository>werkbank:1</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>Eigener Dienst-Container für Medien-Läufe (Defekt-Check, Indizes, Tagging). Lokal gebautes Image – NICHT über „Update“ aktualisieren, sondern per docker build (siehe /mnt/user/appdata/werkbank/skripte/README.md).</Overview>
  <Category>Tools:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/walkxcode/dashboard-icons/main/png/tools.png</Icon>
  <ExtraParams>--restart unless-stopped --cpus=2 --cpu-shares=256 --memory=4g</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Medien" Target="/media" Default="/mnt/user/media" Mode="rw" Description="Medien-Freigabe (lesen + schreiben)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media</Config>
  <Config Name="Werkbank" Target="/werkbank" Default="/mnt/user/appdata/werkbank" Mode="rw" Description="Skripte, Datenbanken, Berichte, Logs" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/werkbank</Config>
  <Config Name="Jellyfin-Daten" Target="/jellyfin" Default="/mnt/cache/appdata/Jellyfin/data" Mode="ro" Description="Jellyfin-DB nur lesen" Type="Path" Display="always" Required="false" Mask="false">/mnt/cache/appdata/Jellyfin/data</Config>
  <Config Name="Host-Locks" Target="/host/lock" Default="/var/lock" Mode="ro" Description="Sperrdatei des WD-Backups (Pause-Erkennung)" Type="Path" Display="advanced" Required="false" Mask="false">/var/lock</Config>
  <Config Name="Host-Run" Target="/host/run" Default="/run" Mode="ro" Description="mover.pid (Pause-Erkennung)" Type="Path" Display="advanced" Required="false" Mask="false">/run</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="" Description="Zeitzone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
  <Config Name="Index-Pfadpräfix" Target="MCSC_SMB_PREFIX" Default="//server/media/" Mode="" Description="So erscheinen /media-Pfade in den Index-DBs (Freigabe, wie der PC sie sieht)" Type="Variable" Display="always" Required="false" Mask="false">//server/media/</Config>
  <Config Name="Jellyfin-URL" Target="MCSC_JELLYFIN_URL" Default="http://jellyfin:8096" Mode="" Description="Jellyfin-Server (Cover für das MKV-Tagging)" Type="Variable" Display="always" Required="false" Mask="false">http://jellyfin:8096</Config>
</Container>
